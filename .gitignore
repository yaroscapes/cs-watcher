# Local state — must NEVER be committed (contains target tracking data)
.state.json

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Editor / OS
.DS_Store
.idea/
.vscode/

# Secrets — defense in depth: even if you accidentally make a .env locally,
# this prevents committing it. Real secrets live in GitHub Secrets.
.env
.env.*
secrets.json
*.pem
*.key

# Local-only reference files (e.g. ids.local.json holds discovered booking
# system IDs). Never committed — keeps target identities out of the public
# repo while staying available locally for adding/changing targets.
*.local.json
*.local.txt
*.local
